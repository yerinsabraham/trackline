{
  "name": "trackline",
  "version": "0.3.0",
  "description": "Watches whether an AI coding agent is still doing what you asked. Runs beside Claude Code or Codex and says when the work stops matching the request.",
  "author": "Yerins Abraham <https://yerinsabraham.com>",
  "homepage": "https://trackline.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yerinsabraham/trackline.git"
  },
  "bugs": {
    "url": "https://github.com/yerinsabraham/trackline/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-alignment",
    "claude-code",
    "codex",
    "guardrails",
    "hooks",
    "llm",
    "evaluation",
    "ci",
    "developer-tools"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "trackline": "./bin/trackline.cjs",
    "trackline-hook": "./bin/trackline-hook.cjs",
    "trackline-gate": "./dist/run.js"
  },
  "files": [
    "bin",
    "dist",
    "datasets",
    "fixtures",
    "baseline.json",
    "harness.config.example.ts",
    "harness.config.example.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "evals": "tsx src/run.ts",
    "evals:live": "tsx src/run.ts --live",
    "evals:record": "tsx src/run.ts --record",
    "evals:baseline": "tsx src/run.ts --update-baseline",
    "doctor": "tsx src/run.ts doctor",
    "prepack": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:binaries": "./scripts/build-binaries.sh",
    "smoke": "./scripts/smoke-install.sh"
  },
  "dependencies": {
    "openai": "^6.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@trackline/darwin-arm64": "0.3.0",
    "@trackline/darwin-x64": "0.3.0",
    "@trackline/linux-x64": "0.3.0",
    "@trackline/linux-arm64": "0.3.0",
    "@trackline/win32-x64": "0.3.0"
  }
}
