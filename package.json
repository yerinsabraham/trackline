{
  "name": "trackline",
  "version": "0.1.0",
  "description": "An alignment layer for AI agents: checks whether an agent's actions still match the task, rules and evidence it was given, across local coding agents and production AI systems.",
  "author": "Yerins Abraham <https://yerinsabraham.com>",
  "homepage": "https://yerinsabraham.com/engineering/nothing-notices-when-an-agent-drifts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yerinsabraham/trackline.git"
  },
  "bugs": {
    "url": "https://github.com/yerinsabraham/trackline/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-alignment",
    "llm",
    "evaluation",
    "claude-code",
    "guardrails",
    "prompt-injection",
    "rag",
    "ci"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "trackline": "./dist/run.js"
  },
  "files": [
    "dist",
    "datasets",
    "fixtures",
    "baseline.json",
    "harness.config.example.ts",
    "harness.config.example.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "evals": "tsx src/run.ts",
    "evals:live": "tsx src/run.ts --live",
    "evals:record": "tsx src/run.ts --record",
    "evals:baseline": "tsx src/run.ts --update-baseline",
    "doctor": "tsx src/run.ts doctor",
    "prepack": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^6.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
